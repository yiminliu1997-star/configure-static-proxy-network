$ErrorActionPreference = 'Stop'
. (Join-Path $PSScriptRoot 'Windows-Proxy.ps1')
$winInet = [Proxy.WindowsProxy]::Read()
$connectionSettings = Get-ItemProperty -LiteralPath 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings\Connections'
$connectionFlags = $connectionSettings.DefaultConnectionSettings[8]
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$target = [uri]'__PROXY_CHECK_URL__'
$systemProxy = [Net.WebRequest]::GetSystemWebProxy().GetProxy($target).AbsoluteUri
$result = Invoke-RestMethod -Uri $target -TimeoutSec 25
[pscustomobject]@{ PowerShellVersion = $PSVersionTable.PSVersion.ToString(); SystemProxy = $systemProxy; WinInetProxy = $winInet[2]; ConnectionFlags = $connectionFlags; ExitIP = $result.ip } | ConvertTo-Json -Compress
if ($systemProxy -ne 'http://127.0.0.1:12460/' -or $winInet[2] -ne '127.0.0.1:12460' -or ($connectionFlags -band 2) -eq 0 -or $result.ip -ne '__PROXY_EXIT_IP__') { throw 'System proxy verification failed.' }
