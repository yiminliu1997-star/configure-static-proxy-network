import net from 'node:net';
import https from 'node:https';
const mode=process.argv[2]||'direct';
function socket(host,port){return new Promise(resolve=>{const s=net.connect({host,port});let done=false;function finish(value){if(done)return;done=true;s.destroy();resolve({host,port,...value});}s.setTimeout(6000,()=>finish({connected:false,error:'TIMEOUT'}));s.once('connect',()=>finish({connected:true}));s.once('error',e=>finish({connected:false,error:e.code}));});}
function proxied(proxy){return new Promise(resolve=>{const agent=new https.Agent({proxyEnv:{HTTPS_PROXY:proxy,HTTP_PROXY:proxy,NO_PROXY:''}});const req=https.get('__PROXY_CHECK_URL__',{agent},res=>{let body='';res.on('data',c=>body+=c);res.on('end',()=>{agent.destroy();try{const j=JSON.parse(body);resolve({success:res.statusCode===200,exit:j.ip,peer:res.socket?.remoteAddress,status:res.statusCode});}catch{resolve({success:false,status:res.statusCode});}});});req.setTimeout(12000,()=>req.destroy(new Error('TIMEOUT')));req.on('error',e=>{agent.destroy();resolve({success:false,error:e.code||e.message});});});}
let result;
if(mode==='direct')result=await Promise.all([socket('1.1.1.1',443),socket('2606:4700:4700::1111',443),socket('223.5.5.5',443),socket('2400:3200::1',443),socket('www.baidu.com',443)]);
else if(mode==='proxy')result=await proxied('http://127.0.0.1:12460');
else if(mode==='dead-proxy')result=await proxied('http://127.0.0.1:12579');
else throw new Error('Unknown test mode');
console.log(JSON.stringify({mode,result}));
