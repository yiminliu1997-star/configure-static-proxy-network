{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "hosts",
        "tag": "bootstrap",
        "predefined": {
          "__PROXY_UPSTREAM_HOST__": []
        }
      },
      {
        "type": "https",
        "tag": "remote",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "detour": "proxy-local"
      }
    ],
    "rules": [
      {
        "domain": [
          "__PROXY_UPSTREAM_HOST__"
        ],
        "server": "bootstrap"
      }
    ],
    "final": "remote"
  },
  "inbounds": [
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "127.0.0.1",
      "listen_port": 15353
    }
  ],
  "outbounds": [
    {
      "type": "http",
      "tag": "proxy-local",
      "server": "127.0.0.1",
      "server_port": 12460
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": [
          "dns-in"
        ],
        "action": "hijack-dns"
      }
    ],
    "final": "proxy-local",
    "default_domain_resolver": "remote"
  }
}
