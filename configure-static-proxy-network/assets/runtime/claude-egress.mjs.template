import https from 'node:https';

// Explicit per-agent proxy: no dependence on inherited environment or Windows settings.
export const proxyUrl = 'http://127.0.0.1:12460';
export const proxyAgent = new https.Agent({
  keepAlive: true,
  proxyEnv: { HTTPS_PROXY: proxyUrl, HTTP_PROXY: proxyUrl, NO_PROXY: '' },
});

export function verifyProxyExit() {
  return new Promise((resolve, reject) => {
    const request = https.get('__PROXY_CHECK_URL__', { agent: proxyAgent }, response => {
      const peer = { address: response.socket.remoteAddress, port: response.socket.remotePort };
      let body = '';
      response.on('data', chunk => { body += chunk; });
      response.on('error', reject);
      response.on('end', () => {
        try {
          const result = JSON.parse(body);
          if (response.statusCode !== 200 || result.proxy?.ip !== '__PROXY_EXIT_IP__' || peer.port !== 12460)
            throw new Error('Proxy exit verification failed');
          resolve({ exitIP: result.ip, proxyPeer: peer });
        } catch (error) { reject(error); }
      });
    });
    request.setTimeout(25000, () => request.destroy(new Error('Exit check timed out')));
    request.on('error', reject);
  });
}
